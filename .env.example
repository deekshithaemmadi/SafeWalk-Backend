# ============================================================================
# SafeWalk Backend — environment variable template
# Copy to `.env` (git-ignored) and fill in real values. NEVER commit `.env`.
# These are PLACEHOLDERS ONLY.
# ============================================================================

# --- Profile ---
# "dev" (default) has local fallbacks; "prod" requires every secret below.
SPRING_PROFILES_ACTIVE=dev

# --- Database (MySQL 8) ---
DB_URL=jdbc:mysql://localhost:3306/safewalk?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me
# Aiven Cloud MySQL example (SSL required):
# DB_URL=jdbc:mysql://<aiven-host>:<aiven-port>/safewalk?ssl-mode=REQUIRED

# --- JWT ---
# Required in prod. Use >= 32 random bytes, e.g. `openssl rand -base64 48`.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=86400000

# --- CORS (comma-separated allowed frontend origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- External map services (optional overrides) ---
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# OSRM_BASE_URL=https://router.project-osrm.org
# Nominatim's usage policy requires an identifying User-Agent with contact info.
# MAPS_USER_AGENT=SafeWalkBackend/1.0 (you@example.com)
# MAPS_CONNECT_TIMEOUT_MS=5000
# MAPS_READ_TIMEOUT_MS=10000
