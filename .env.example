# ============================================================================
# SafeWalk Backend — environment variable template
# Copy to `.env` (git-ignored) and fill in real values. NEVER commit `.env`.
# These are PLACEHOLDERS ONLY.
# ============================================================================

# --- Database (MySQL) ---
# Local development example:
DB_URL=jdbc:mysql://localhost:3306/safewalk?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me

# Aiven Cloud MySQL example (set real host/port/password; SSL required):
# DB_URL=jdbc:mysql://<aiven-host>:<aiven-port>/safewalk?ssl-mode=REQUIRED
# DB_USERNAME=avnadmin
# DB_PASSWORD=<your-aiven-password>

# --- CORS (comma-separated allowed origins) ---
# Local dev default is http://localhost:5173 (the Vite frontend).
CORS_ALLOWED_ORIGINS=http://localhost:5173
